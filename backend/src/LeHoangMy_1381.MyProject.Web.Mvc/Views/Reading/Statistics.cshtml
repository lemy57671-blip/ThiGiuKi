@model LeHoangMy_1381.MyProject.Toeic.ExamStatistics
@{ Layout="~/Views/Shared/_ReadingLayout.cshtml"; ViewBag.Title="Thống kê & Phân tích kết quả thi"; var exams=(System.Collections.Generic.List<LeHoangMy_1381.MyProject.Toeic.ExamSummary>)ViewBag.Exams; }
<section class="heading-row panel"><div><span class="eyebrow">PHÂN TÍCH KẾT QUẢ HỌC VIÊN</span><h1>Thống kê & Phân tích kết quả thi</h1><p>Theo dõi kết quả của các lượt thi đã hoàn tất.</p></div><form action="/Reading/Statistics" method="get"><label>Chọn đề thi<select name="id" onchange="this.form.submit()">@foreach(var exam in exams) { <option value="@exam.Id" selected="@(exam.Id == Model?.Exam.Id)">@exam.SourceId v@(exam.Version) — @exam.Title</option> }</select></label></form></section>
@if (Model == null) { <section class="panel"><h2>Chưa có đề thi</h2><a href="/Reading/Upload">Nhập đề từ Word →</a></section> }
else
{
<section class="metrics"><article class="metric"><span>TỔNG LƯỢT LÀM BÀI</span><strong id="total-attempts">@Model.TotalAttempts</strong><small>gồm đang làm và hoàn tất</small></article><article class="metric mint"><span>ĐIỂM TRUNG BÌNH</span><strong id="average-accuracy">@(Model.AverageAccuracyPercent?.ToString("0.00") ?? "—")@(Model.AverageAccuracyPercent.HasValue ? "%" : "")</strong><small>@Model.CompletedAttempts lượt đã nộp / hết giờ</small></article><article class="metric peach"><span>ĐANG LÀM BÀI</span><strong>@(Model.TotalAttempts-Model.CompletedAttempts)</strong><small>không tính vào điểm trung bình</small></article><article class="metric"><span>PHẠM VI CÂU HỎI</span><strong>101–200</strong><small>Part 5 · Part 6 · Part 7</small></article></section>
<div class="statistics-grid"><section class="panel"><h2>Phổ phân bố điểm số học viên</h2><p>Số lượt đã nộp/hết giờ theo tỷ lệ đúng.</p><div class="score-chart" aria-label="Phân bố tỷ lệ đúng từ SQL Server">
@foreach(var bin in Model.Distribution) { var height=(int)System.Math.Round(bin.Count*100.0/System.Math.Max(1,Model.Distribution.Max(b=>b.Count))); <div class="score-bin"><strong>@bin.Count</strong><div class="score-track"><div class="score-bar" style="height:@(height)%"></div></div><small>@bin.Label</small></div> }
</div></section><section class="panel"><h2>Tỷ lệ trả lời đúng theo Part</h2><p>Tính trên tất cả câu thuộc các lượt đã hoàn tất.</p>@if(Model.Parts.Count==0) { <p>Chưa có kết quả để phân tích.</p> }@foreach(var p in Model.Parts) { <div class="part-stat"><div><b>Part @p.PartNumber</b><span>@((p.Correct*100m/System.Math.Max(1,p.Total)).ToString("0.00"))%</span></div><progress value="@p.Correct" max="@System.Math.Max(1,p.Total)"></progress><small>@p.Correct đúng · @p.Wrong sai · @p.Skipped bỏ qua / @p.Total câu</small></div> }</section></div>
<section class="panel"><div class="heading-row"><h2>Top 10 câu hỏi bị trả lời sai nhiều nhất</h2><div class="actions"><a class="pill @(ViewBag.Part==null?"lavender":"")" href="/Reading/Statistics/@Model.Exam.Id">Tất cả</a>@foreach(var part in new[]{5,6,7}) { <a class="pill @(ViewBag.Part==(int?)part?"lavender":"")" href="/Reading/Statistics/@(Model.Exam.Id)?part=@part">Part @part</a> }</div></div><p>Chỉ đếm lựa chọn đã lưu khác đáp án đúng của lượt thi đã hoàn tất. Câu bỏ trống được tính riêng, không đưa vào Top sai.</p>
@if (Model.TopWrong.Count == 0) { <div class="empty"><span>♧</span><h2>Chưa có câu trả lời sai</h2><p>Thống kê sẽ cập nhật sau khi có bài nộp với lựa chọn sai.</p></div> }
else { <table id="top-wrong"><thead><tr><th>HẠNG</th><th>CÂU HỎI</th><th>SỐ LƯỢT SAI</th><th>PHÂN BỐ</th></tr></thead><tbody>@for(var i=0;i<Model.TopWrong.Count;i++) { var row=Model.TopWrong[i]; <tr><td>@(i+1)</td><td><a href="/Reading/Preview/@Model.Exam.Id?number=@row.OriginalNumber">Câu @row.OriginalNumber ↗</a></td><td>@row.WrongCount</td><td><progress value="@row.WrongCount" max="@System.Math.Max(1,Model.CompletedAttempts)"></progress></td></tr> }</tbody></table> }
</section><p class="notice">Tỷ lệ đúng = số câu đúng / 100 × 100. Điểm trung bình = trung bình tỷ lệ đúng của các lượt SUBMITTED/EXPIRED; không quy đổi sang thang TOEIC 495/990.</p>
}
